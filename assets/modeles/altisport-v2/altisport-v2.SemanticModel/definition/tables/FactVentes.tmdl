	partition FactVentes = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents(DossierData & "\ventes.csv"), [Delimiter = ";", Columns = 13, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
