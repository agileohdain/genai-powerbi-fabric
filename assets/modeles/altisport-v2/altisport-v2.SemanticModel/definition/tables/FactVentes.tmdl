				    #"Colonnes renommées" = Table.RenameColumns(#"Type de colonne changé",{{"VteID", "VenteID"}, {"DtVte", "DateVente"}, {"StatutCde", "StatutCommande"}, {"ProdID", "IdProduit"}, {"Qt", "Quantite"}, {"TxRem", "TauxRemise"}, {"MttBrutTTC", "MontantBrutTTC"}, {"MttTTcNet", "MontantNetTTC"}, {"CstLigne", "CoutLigne"}, {"MagID", "IdMagasin"}, {"VndID", "IdVendeur"}, {"CustNo", "IdClient"}}),
				    #"Type modifié" = Table.TransformColumnTypes(#"Colonnes renommées",{{"MontantBrutTTC", type number}}),
				    #"Personnalisée ajoutée" = Table.AddColumn(#"Type modifié", "DateKey", each Number.FromText(Date.ToText([DateVente], "yyyyMMdd"))),
				    #"Type modifié1" = Table.TransformColumnTypes(#"Personnalisée ajoutée",{{"DateKey", Int64.Type}}),
				    #"Majuscule à chaque mot" = Table.TransformColumns(#"Type modifié1",{{"StatutCommande", Text.Proper, type text}, {"Canal", Text.Proper, type text}}),
				    #"Espaces supprimés" = Table.TransformColumns(#"Majuscule à chaque mot",{{"StatutCommande", Text.Trim, type text}, {"Canal", Text.Trim, type text}})
				in
